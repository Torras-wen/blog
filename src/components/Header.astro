---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="brand-name">{SITE_TITLE}</span>
			<span class="brand-dot" aria-hidden="true">.</span>
		</a>

		<div class="nav-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>

		<div class="nav-actions">
			<button
				id="theme-toggle"
				class="icon-button theme-toggle"
				type="button"
				aria-label="切换深色 / 浅色模式"
			>
				<svg
					class="icon moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					width="19"
					height="19"
				>
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg
					class="icon sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					width="19"
					height="19"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path
						d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
					></path>
				</svg>
			</button>

			<a
				class="icon-button"
				href="https://github.com/xiucai5"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		backdrop-filter: saturate(180%) blur(14px);
		-webkit-backdrop-filter: saturate(180%) blur(14px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: var(--header-height);
		width: var(--container-wide);
		max-width: calc(100% - 2 * var(--gutter));
		margin-inline: auto;
	}
	.brand {
		display: inline-flex;
		align-items: baseline;
		color: var(--text);
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.3rem;
		letter-spacing: -0.02em;
	}
	.brand:hover {
		color: var(--text);
	}
	.brand-dot {
		color: var(--accent);
	}
	.nav-links {
		display: flex;
		align-items: center;
		margin-inline: auto;
	}
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.theme-toggle .icon {
		display: none;
	}
	.theme-toggle .moon {
		display: block;
	}
	:root[data-theme='dark'] .theme-toggle .moon {
		display: none;
	}
	:root[data-theme='dark'] .theme-toggle .sun {
		display: block;
	}
	@media (max-width: 540px) {
		nav {
			gap: 0.5rem;
		}
	}
</style>

<script>
	// Theme toggle
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const next =
			document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
	});

	// Reveal-on-scroll
	const items = document.querySelectorAll('[data-reveal]');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (items.length && !reduce) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
		);
		items.forEach((el) => io.observe(el));
	} else {
		items.forEach((el) => el.classList.add('is-visible'));
	}
</script>
