---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<a class="footer-name" href="/">{SITE_TITLE}<span aria-hidden="true">.</span></a>
			<p>记录 Shopify 开发、AI 工具与一些折腾过程。</p>
		</div>

		<nav class="footer-links" aria-label="页脚导航">
			<a href="/">首页</a>
			<a href="/blog">博客</a>
			<a href="/about">关于</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>

	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<div class="social-links">
			<a
				href="https://github.com/xiucai5"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<a href="/rss.xml" aria-label="RSS 订阅">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					width="18"
					height="18"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		flex-shrink: 0;
		margin-top: 5rem;
		border-top: 1px solid var(--border);
		background: var(--bg-subtle);
		color: var(--text-muted);
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2rem;
		width: var(--container-wide);
		max-width: calc(100% - 2 * var(--gutter));
		margin-inline: auto;
		padding: 3rem 0 2rem;
	}
	.footer-name {
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-weight: 600;
		color: var(--text);
		letter-spacing: -0.02em;
	}
	.footer-name span {
		color: var(--accent);
	}
	.footer-brand p {
		margin: 0.5rem 0 0;
		max-width: 26rem;
		font-size: 0.95rem;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.4rem;
	}
	.footer-links a {
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: var(--container-wide);
		max-width: calc(100% - 2 * var(--gutter));
		margin-inline: auto;
		padding: 1.4rem 0;
		border-top: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--text-faint);
	}
	.social-links {
		display: flex;
		gap: 0.4rem;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		color: var(--text-muted);
		border-radius: var(--radius-sm);
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--text);
		background: var(--surface-hover);
	}
	@media (max-width: 540px) {
		.footer-inner {
			flex-direction: column;
			gap: 1.5rem;
		}
	}
</style>
