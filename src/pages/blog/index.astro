---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head" data-reveal>
				<span class="kicker">归档</span>
				<h1>博客</h1>
				<p>共 {posts.length} 篇 · 记录开发、工具与思考。</p>
			</header>

			<ul class="post-index">
				{
					posts.map((post, i) => (
						<li data-reveal style={`--reveal-delay:${Math.min(i, 8) * 50}ms`}>
							<a href={`/blog/${post.id}/`}>
								<span class="idx">{String(i + 1).padStart(2, '0')}</span>
								<span class="entry">
									<span class="entry-title">{post.data.title}</span>
									<span class="entry-desc">{post.data.description}</span>
								</span>
								<span class="entry-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="arrow" aria-hidden="true">
									→
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 880px;
	}
	.page-head {
		margin-bottom: 2.5rem;
	}
	.page-head h1 {
		margin: 0.8rem 0 0.5rem;
		font-size: clamp(2.4rem, 6vw, 3.4rem);
		font-weight: 600;
		letter-spacing: -0.025em;
	}
	.page-head p {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.05rem;
	}
	.post-index {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.post-index li {
		border-bottom: 1px solid var(--border);
	}
	.post-index a {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: baseline;
		column-gap: clamp(1rem, 3vw, 2.2rem);
		padding: 1.7rem 0.4rem;
		color: inherit;
		transition:
			padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
			background-color 0.3s ease;
	}
	.post-index a:hover {
		padding-inline: 1.2rem;
		background: var(--surface-hover);
	}
	.idx {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.entry-title {
		display: block;
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2.5vw, 1.7rem);
		font-weight: 600;
		line-height: 1.25;
		transition: color 0.2s ease;
	}
	.post-index a:hover .entry-title {
		color: var(--accent);
	}
	.entry-desc {
		display: block;
		margin-top: 0.4rem;
		color: var(--text-muted);
		font-size: 0.94rem;
	}
	.entry-date {
		color: var(--text-faint);
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.arrow {
		color: var(--accent);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}
	.post-index a:hover .arrow {
		opacity: 1;
		transform: translateX(0);
	}
	@media (max-width: 640px) {
		.post-index a {
			grid-template-columns: 1fr auto;
			column-gap: 1rem;
		}
		.idx,
		.arrow,
		.entry-desc {
			display: none;
		}
	}
</style>
