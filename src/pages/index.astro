---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const more = rest.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" data-reveal>
				<span class="kicker">WG BLOG</span>
				<h1>记录开发，<br />也记录折腾<span class="dot">.</span></h1>
				<p class="hero-sub">Notes on Shopify, AI tools &amp; the occasional side quest.</p>
				<p class="hero-desc">{SITE_DESCRIPTION}</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/blog">浏览全部文章</a>
					<a class="button button-ghost" href="/about">关于我</a>
				</div>
			</section>

			{
				featured && (
					<section class="featured">
						<div class="rule" data-reveal>
							<span class="kicker">最新一篇</span>
						</div>
						<a class="feature-card" href={`/blog/${featured.id}/`} data-reveal>
							{featured.data.heroImage && (
								<div class="feature-media">
									<Image
										width={880}
										height={620}
										src={featured.data.heroImage}
										alt=""
									/>
								</div>
							)}
							<div class="feature-body">
								<div class="feature-meta">
									<FormattedDate date={featured.data.pubDate} />
								</div>
								<h2>{featured.data.title}</h2>
								<p>{featured.data.description}</p>
								<span class="read-more">
									阅读全文 <span aria-hidden="true">→</span>
								</span>
							</div>
						</a>
					</section>
				)
			}

			{
				more.length > 0 && (
					<section class="more">
						<div class="rule section-head" data-reveal>
							<span class="kicker">更多文章</span>
							<a class="more-link" href="/blog">
								全部 <span aria-hidden="true">→</span>
							</a>
						</div>
						<ul class="post-index">
							{more.map((post, i) => (
								<li data-reveal style={`--reveal-delay:${i * 60}ms`}>
									<a href={`/blog/${post.id}/`}>
										<span class="idx">{String(i + 2).padStart(2, '0')}</span>
										<span class="entry">
											<span class="entry-title">{post.data.title}</span>
											<span class="entry-desc">{post.data.description}</span>
										</span>
										<span class="entry-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="arrow" aria-hidden="true">
											→
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: var(--container-wide);
	}

	/* Hero */
	.hero {
		padding: 3rem 0 4.5rem;
		max-width: 46rem;
	}
	.hero h1 {
		margin: 1.2rem 0 0;
		font-size: clamp(2.8rem, 7vw, 4.6rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.hero .dot {
		color: var(--accent);
	}
	.hero-sub {
		margin: 1.2rem 0 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.2rem, 3vw, 1.6rem);
		color: var(--text-muted);
	}
	.hero-desc {
		margin: 1.4rem 0 0;
		max-width: 34rem;
		font-size: 1.1rem;
		color: var(--text-muted);
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 2.2rem;
	}

	/* Section rule + heading */
	.rule {
		padding-top: 1.2rem;
		border-top: 1px solid var(--border);
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.more-link {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-muted);
	}
	.more-link:hover {
		color: var(--accent);
	}
	.more-link span {
		transition: transform 0.25s ease;
		display: inline-block;
	}
	.more-link:hover span {
		transform: translateX(3px);
	}

	/* Featured */
	.featured {
		margin-top: 4.5rem;
	}
	.feature-card {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		margin-top: 1.8rem;
		color: inherit;
	}
	.feature-media {
		overflow: hidden;
		border-radius: var(--radius-lg);
		aspect-ratio: 4 / 3;
		background: var(--bg-subtle);
		box-shadow: var(--shadow-sm);
	}
	.feature-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.feature-card:hover .feature-media :global(img) {
		transform: scale(1.05);
	}
	.feature-meta {
		font-size: 0.85rem;
		color: var(--text-faint);
		margin-bottom: 0.8rem;
	}
	.feature-body h2 {
		margin: 0 0 0.7rem;
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		line-height: 1.15;
		transition: color 0.2s ease;
	}
	.feature-card:hover .feature-body h2 {
		color: var(--accent);
	}
	.feature-body p {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.02rem;
	}
	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.3rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--accent);
	}
	.read-more span {
		transition: transform 0.25s ease;
	}
	.feature-card:hover .read-more span {
		transform: translateX(4px);
	}

	/* Editorial index list */
	.more {
		margin-top: 5rem;
	}
	.post-index {
		list-style: none;
		margin: 1.8rem 0 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.post-index li {
		border-bottom: 1px solid var(--border);
	}
	.post-index a {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: baseline;
		column-gap: clamp(1rem, 3vw, 2.2rem);
		padding: 1.6rem 0.4rem;
		color: inherit;
		transition:
			padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
			background-color 0.3s ease;
	}
	.post-index a:hover {
		padding-inline: 1.2rem;
		background: var(--surface-hover);
	}
	.idx {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.entry-title {
		display: block;
		font-family: var(--font-serif);
		font-size: clamp(1.25rem, 2.5vw, 1.6rem);
		font-weight: 600;
		line-height: 1.25;
		transition: color 0.2s ease;
	}
	.post-index a:hover .entry-title {
		color: var(--accent);
	}
	.entry-desc {
		display: block;
		margin-top: 0.35rem;
		color: var(--text-muted);
		font-size: 0.92rem;
	}
	.entry-date {
		color: var(--text-faint);
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.arrow {
		color: var(--accent);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}
	.post-index a:hover .arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 760px) {
		.feature-card {
			grid-template-columns: 1fr;
		}
		.feature-media {
			aspect-ratio: 16 / 9;
		}
	}
	@media (max-width: 640px) {
		.post-index a {
			grid-template-columns: 1fr auto;
			column-gap: 1rem;
		}
		.idx,
		.arrow,
		.entry-desc {
			display: none;
		}
	}
</style>
