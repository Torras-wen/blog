---
import PostCover from '../components/PostCover.astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<a class="back-link" href="/blog">
					<span class="back-arrow" aria-hidden="true">←</span> 返回博客
				</a>

				<header class="post-header" data-reveal>
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									· 更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					{description && <p class="lead">{description}</p>}
				</header>

				<figure class="hero-image" data-reveal>
					<PostCover seed={title} class="hero-cover" />
				</figure>

				<div class="prose" data-reveal>
					<slot />
				</div>

				<footer class="post-footer">
					<a class="button button-ghost" href="/blog">
						<span aria-hidden="true">←</span> 返回全部文章
					</a>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 820px;
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 2rem;
		font-size: 0.92rem;
		color: var(--text-muted);
	}
	.back-link:hover {
		color: var(--accent);
	}
	.back-arrow {
		transition: transform 0.25s ease;
		display: inline-block;
	}
	.back-link:hover .back-arrow {
		transform: translateX(-3px);
	}

	.post-header {
		max-width: 46rem;
		margin: 0 auto 2.8rem;
		text-align: center;
	}
	.post-meta {
		margin-bottom: 1rem;
		font-size: 0.85rem;
		letter-spacing: 0.02em;
		color: var(--text-faint);
	}
	.updated {
		font-style: italic;
	}
	.post-header h1 {
		margin: 0 0 0.9rem;
		font-size: clamp(2.2rem, 5.5vw, 3.6rem);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.025em;
	}
	.lead {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.2rem;
		line-height: 1.6;
	}

	.hero-image {
		margin: 0 0 3.2rem;
		aspect-ratio: 5 / 2;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow);
	}
	.hero-image :global(.cover) {
		width: 100%;
		height: 100%;
	}

	.prose {
		max-width: 720px;
		margin: 0 auto;
	}

	.post-footer {
		max-width: 720px;
		margin: 3.5rem auto 0;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
</style>
